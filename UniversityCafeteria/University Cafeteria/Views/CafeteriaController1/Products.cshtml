@{
    Layout = "_MainLayout";
}

@* <h2>Products</h2> *@
<p>The cafeteria products will appear here.</p>

@section Scripts {
    <script>
        alert("Welcome to the Products Page!");
    </script>
}
@{
    string[] products =
    {
        "Water",
        "Orange Juice",
        "Coffee",
        "Sandwich",
        "Chocolate"
    };
}
<link rel="stylesheet" href="~/css/products.css" />

<h2>Products</h2>

@if (products.Length > 0)
{
    <p>Products are available.</p>

    <ul class="product-list">
        @foreach (string product in products)
        {
            <li>@product</li>
        }
    </ul>
}
else
{
    <p>No products are available.</p>
}

@if (products.Length >= 3)
{
    <p>We have enough Products.</p>
}
else
{
    <p>We need more Products.</p>
}

