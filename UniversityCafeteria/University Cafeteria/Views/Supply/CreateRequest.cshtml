
@{
    ViewData["Title"] = "Create Request";
}

<div class="container mt-5">
    <div class="card shadow p-4">

        <h3>Create Supply Request</h3>

        @if (ViewBag.Message != null)
        {
            <div class="alert alert-info">
                @ViewBag.Message
            </div>
        }
<!--this is a important part of the code -->
        <form asp-controller="Supply"
              asp-action="SubmitRequest"
              method="post">

            <div class="mb-3">
                <label class="form-label">
                    Employee Name
                </label>

                <input type="text"
                       name="EmployeeName"
                       class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">
                    Product Name
                </label>

                <select name="ProductName"
                        class="form-select"
                        required>
                    <option value="">Select Product</option>
                    <option value="Water">Water</option>
                    <option value="Orange Juice">Orange Juice</option>
                    <option value="Coffee">Coffee</option>
                    <option value="Sandwich">Sandwich</option>
                    <option value="Chocolate">Chocolate</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">
                    Quantity
                </label>

                <input type="number"
                       name="Quantity"
                       class="form-control"
                       min="1"
                       required />
            </div>

            <div class="mb-3">
                <label class="form-label">
                    Required Date
                </label>

                <input type="date"
                       name="RequiredDate"
                       class="form-control"
                       required />
            </div>

            <button type="submit" class="btn btn-primary">
                Submit Request
            </button>

        </form>
    </div>
</div>
