
@{
    ViewData["Title"] = "Products";
}

<div class="container mt-5">
    <div class="card shadow" style="width: 18rem;">

        <div class="card-body">

            <h5 class="card-title">
                @ViewData["Page Title"]
            </h5>

            <p class="card-text">
                Manager: @ViewData["Manager Name"]
            </p>

            <p class="card-text">
                Number of Products: @ViewData["Number of Products"]
            </p>

            <ul class="list-group list-group-flush">
                @foreach (string product in (string[])ViewData["Products"]!)
                {
                    <li class="list-group-item">@product</li>
                }
            </ul>

        </div>
    </div>
</div>
