@{
    ViewData["Title"] = "Review Supply Request";

    var products =
        ViewBag.Products as List<Dictionary<string, string>>
        ?? new List<Dictionary<string, string>>();
}

<div class="container mt-4">

    <h2>Review Supply Request</h2>

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Product</th>
                <th>Quantity</th>
                <th>Unit Price</th>
                <th>Product Total</th>
                <th>Priority</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var product in products)
            {
                <tr>
                    <td>@product["ProductName"]</td>
                    <td>@product["Quantity"]</td>
                    <td>@product["UnitPrice"] JD</td>
                    <td>@product["ProductTotal"] JD</td>
                    <td>@product["Priority"]</td>
                </tr>
            }
        </tbody>
    </table>

    <hr />

    <h3>Cost Summary</h3>

    <p>Subtotal: @ViewBag.Subtotal JD</p>

    <p>
        Preparation Fee (@ViewBag.Priority):
        @ViewBag.PreparationFee JD
    </p>

    <p>Discount: @ViewBag.Discount JD</p>

    <h4>Final Total: @ViewBag.FinalTotal JD</h4>
    <form method="post"
          action="@Url.Action("ConfirmRequest", "SupplyRequest")">

        @Html.AntiForgeryToken()

        <button type="submit" class="btn btn-success">
            Confirm Request
        </button>
    </form>
    <a href="@Url.Action("Index", "SupplyRequest")"
       class="btn btn-secondary">
        Back to Products
    </a>

</div>