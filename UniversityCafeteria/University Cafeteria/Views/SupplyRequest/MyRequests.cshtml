@{
    ViewData["Title"] = "My Supply Requests";

    var requests =
        ViewBag.Requests as List<Dictionary<string, string>>
        ?? new List<Dictionary<string, string>>();
}

<div class="container mt-4">

    <h2>My Supply Requests</h2>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">
            @TempData["Message"]
        </div>
    }

    @if (requests.Count == 0)
    {
        <p>No confirmed requests yet.</p>
    }
    else
    {
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Request ID</th>
                    <th>Number of Products</th>
                    <th>Subtotal</th>
                    <th>Preparation Fee</th>
                    <th>Discount</th>
                    <th>Final Total</th>
                    <th>Status</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var request in requests)
                {
                    <tr>
                        <td>@request["RequestID"]</td>
                        <td>@request["NumberOfProducts"]</td>
                        <td>@request["Subtotal"] JD</td>
                        <td>@request["PreparationFee"] JD</td>
                        <td>@request["Discount"] JD</td>
                        <td>@request["FinalTotal"] JD</td>
                        <td>
                            <span class="badge bg-success">
                                @request["Status"]
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <a href="@Url.Action("Index", "SupplyRequest")"
       class="btn btn-primary">
        Create New Request
    </a>

</div>