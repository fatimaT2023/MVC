    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@* httpget *@
@{
    ViewData["Title"] = "Supply Request";
}
<div class="container mb-4">
@* <h2> create supply requests</h2> *@
@* <p> welcom to the request mangment system</p> *@

<a href="@Url.Action("Review", "SupplyRequest")"
 class="btn btn-primary">
Review Supply Requests
</a>
<a href="@Url.Action("MyRequests", "SupplyRequest")"
   class="btn btn-success">
    My Requests
</a>
<a href="@Url.Action("About", "SupplyRequest")"
   class="btn btn-secondary">
    About
</a>
</div>
@if (TempData["Message"] != null)
{
    <p style="color:green">@TempData["Message"]</p>
}

@if (TempData["Error"] != null)
{
    <p style="color:red">@TempData["Error"]</p>
}
<div class="container mb-4">
<h2> Create Supply Requests</h2>
    <div class="mb-4">

        <h3>Employee Priority Preference</h3>

        <form method="post"
              action="@Url.Action("SavePreference", "SupplyRequest")">

            @Html.AntiForgeryToken()

            <label>Priority:</label>

            <select name="priority" required>

                <option value="Normal"
                        selected="@(ViewBag.PreferredPriority == "Normal")">
                    Normal
                </option>

                <option value="Urgent"
                        selected="@(ViewBag.PreferredPriority == "Urgent")">
                    Urgent
                </option>

                <option value="Emergency"
                        selected="@(ViewBag.PreferredPriority == "Emergency")">
                    Emergency
                </option>

            </select>

            <br />

            <button type="submit" class="btn btn-primary">
                Save Preference
            </button>

        </form>

        <p class="mt-3">
            Your preferred request priority is
            <strong>@ViewBag.PreferredPriority</strong>.
        </p>

    </div>
<form method="post" action="@Url.Action("AddItem", "SupplyRequest")">
        @Html.AntiForgeryToken()
<label> Product Name:</label>
        <input type="text" name="productName" class="form-control" required />

<br /> <br />
<label>Category:</label>
      <select name="category" class="form-control" required>
            <option value="">Select Category</option>
            <option value="Food">Food</option>
            <option value="Drinks">Drinks</option>
            <option value="Packaging">Packaging</option>
      </select>


<br /><br />
        <label>Quantity:</label>
        <input type="number"
               name="quantity"
               min="1"
               required />

        <br /><br />
<label> Unit Price:</label>
        <input type="number" name="unitPrice"  min="0.01" step="0.01" required />

        <br /><br />
<label> Priority:</label>
        <select name="priority" required>
            <option value="Normal">Normal</option>
            <option value="Urgent">Urgent</option>
            <option value="Emergency">Emergency</option>
        </select>
<br /><br />
<button type="submit"> Add Product</button>

</form>
</div>
<br />
<h3> Added Products</h3>
@{
    List<Dictionary<string, string>> products =
        ViewBag.Products as List<Dictionary<string, string>>
        ?? new List<Dictionary<string, string>>();
}

@if (products.Count == 0)
{
    <p>No products added yet.</p>
}
else
{
    <ul>
        @foreach (var product in products)
        {
            <li>
                @product["ProductName"] |
                Quantity: @product["Quantity"] |
                Unit Price: @product["UnitPrice"] JD |
                Priority: @product["Priority"]
            </li>
        }
    </ul>
}
@if (products.Count > 0)
{
    <form method="post"
          action="@Url.Action("ClearDraft", "SupplyRequest")">

        @Html.AntiForgeryToken()

        <button type="submit" class="btn btn-danger">
            Clear Draft
        </button>
    </form>
}