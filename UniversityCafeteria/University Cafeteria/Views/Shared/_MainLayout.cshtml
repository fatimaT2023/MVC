<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>University Cafeteria</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    @RenderSection("Styles", required: false);
</head>
<body>
    <header class="bg-dark text-white p-3">
        <h3 class="mb-0">University Cafeteria</h3>

        <nav>
            <ul class="navbar-nav flex-row flex-wrap gap-4">

                <li class="nav-item">
                    <a class="nav-link"
                       href="@Url.Action("Index", "Home")">
                        Home
                    </a>
                </li>

                @* <li class="nav-item">
                    <a class="nav-link"
                       href="@Url.Action("Index", "Products")">
                        Products
                    </a>
                </li> *@

                @* <li class="nav-item">
                    <a class="nav-link"
                       href="@Url.Action("Index", "Suppliers")">
                        Suppliers
                    </a>
                </li> *@

                <li class="nav-item">
                    <a class="nav-link"
                       href="@Url.Action("Index", "SupplyRequest")">
                        Create Supply Request
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link"
                       href="@Url.Action("Review", "SupplyRequest")">
                        Review Draft
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link"
                       href="@Url.Action("MyRequests", "SupplyRequest")">
                        My Requests
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link"
                       href="@Url.Action("About", "SupplyRequest")">
                        About
                    </a>
                </li>

            </ul>

        </nav>
    </header>

    <main class="container my-4">
        @RenderBody()
    </main>

    <footer class="bg-light text-center p-3">
        University Cafeteria — Supply Management System
    </footer>
    @RenderSection("scripts", required: false);
</body>
</html>