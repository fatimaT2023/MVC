@model IEnumerable<task8.Models.UserRoleDTO>

<h2>Manage Users</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Full Name</th>
            <th>Email</th>
            <th>Role</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.FullName</td>
                <td>@user.Email</td>
                <td>@user.Role</td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@user.Id"
                       class="btn btn-primary btn-sm">
                        Edit Role
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@user.Id"
                       class="btn btn-danger btn-sm">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
