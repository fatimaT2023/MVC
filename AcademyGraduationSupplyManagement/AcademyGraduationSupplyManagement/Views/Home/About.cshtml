
@{
    ViewData["Title"] = "About";
}

<div class="container mt-5">

    <h2>About Our System</h2>

    <h4>
        Academy Graduation Ceremony
        Supply Management System
    </h4>

    <p class="mt-3">
        This system helps academy staff manage
        supply requests for graduation ceremonies.
    </p>

    <p>
        Staff members can compare supplier offers,
        select one offer from each category,
        and review the total cost and discounts.
    </p>

    <h5>Supply Categories</h5>

    <ul>
        <li>Graduation Certificates</li>
        <li>Hospitality</li>
        <li>Graduation Gifts</li>
    </ul>

    <a href="@Url.Action("Index", "Supply")"
       class="btn btn-primary mt-3">
        Create Supply Request
    </a>

</div>
