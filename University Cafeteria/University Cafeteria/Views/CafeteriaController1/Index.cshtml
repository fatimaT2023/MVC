@* home page *@
@{
    Layout = "_MainLayout";
}

@{
    <h1>University Cafeteria</h1>

    <p>Welcome to the Cafeteria Supply Management System.</p>
    <p>View our products, suppliers, and supply status.</p>

    <ul>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="" asp-controller="CafeteriaController1" asp-action="Products">Products</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="" asp-controller="CafeteriaController1" asp-action="Suppliers">Suppliers</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="" asp-controller="CafeteriaController1" asp-action="SupplyStatus">Supply Status</a>
        </li>
    </ul>
}


@section Scripts {
    <script>
        string universityName = "Orange University";
        string managerName = "Ahmad Ali";
        int totalProducts = 5;
    </script>
    @{
        string universityName = "Orange University";
        string managerName = "Ahmad Ali";
        int totalProducts = 5;
    }

    <p>Welcome to @universityName Cafeteria!</p>

    <p>Manager: @managerName</p>

    <p>Total Products: @totalProducts</p>
}

