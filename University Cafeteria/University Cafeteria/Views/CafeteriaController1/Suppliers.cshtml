@{
    Layout = "_SimpleLayout";

    string[] suppliers =
            {
               "Fresh Food Company",
        "Happy Drinks Company",
        "Daily Supplies Company"
    };
}
<h2> Suppliers</h2>
<ul>
    @foreach (string supplier in suppliers)
    {
        <li>@suppliers</li>

    }
</ul>
@if (suppliers.Length >= 3)
{
    <p>we have enouph suppliers .</p>
}
else
{
    <p>we need more suppliers</p>
}

