@model task7.Models.Employee7

<h2>Employee Details</h2>

<p><strong>ID:</strong> @Model.Id</p>
<p><strong>Full Name:</strong> @Model.FullName</p>
<p><strong>Phone:</strong> @Model.phone</p>
<p><strong>Email:</strong> @Model.email</p>
<p><strong>Position:</strong> @Model.Position</p>
<p><strong>Salary:</strong> @Model.Salary</p>
<p><strong>Hire Date:</strong> @Model.HireDate.ToShortDateString()</p>
<p><strong>Orders Count:</strong> @Model.Orders.Count</p>

<a asp-action="Index" class="btn btn-secondary">
    Back
</a>