@model task7.Models.Order

<h2>Order Details</h2>

<p><strong>ID:</strong> @Model.Id</p>
<p><strong>Customer Name:</strong> @Model.CustomerName</p>
<p><strong>Order Date:</strong> @Model.OrderDate.ToShortDateString()</p>
<p><strong>Total Price:</strong> @Model.TotalPrice</p>
<p><strong>Status:</strong> @Model.Status</p>
<p><strong>Employee:</strong> @Model.Employee.FullName</p>

<a asp-action="Index" class="btn btn-secondary">
    Back
</a>